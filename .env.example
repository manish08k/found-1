# ═══════════════════════════════════════════════════════════════════════════════
#  AutoFlow — Operator Environment Configuration
#
#  HOW IT WORKS (like n8n):
#    1. Operator registers OAuth apps ONCE on each provider's developer console
#       and puts the client_id/secret here.
#    2. End-users never see these values. They just click "Connect" in the UI,
#       go through the provider's OAuth consent screen, and AutoFlow stores
#       their encrypted token automatically.
#    3. WhatsApp & Telegram use long-lived tokens — operator sets them once here.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App
APP_ENV=production
APP_BASE_URL=https://your-domain.com
APP_SECRET_KEY=CHANGE_ME_64_CHAR_HEX
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY

# ── Database
POSTGRES_PASSWORD=autoflow_secret

# ── Redis
REDIS_PASSWORD=redis_secret

# ── Flower
FLOWER_USER=admin
FLOWER_PASSWORD=change_me

# ── Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI: https://your-domain.com/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Slack (https://api.slack.com/apps)
# Redirect URI: https://your-domain.com/oauth/callback/slack
# Events URL:   https://your-domain.com/webhooks/slack/events
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── GitHub (https://github.com/settings/applications/new)
# Redirect URI: https://your-domain.com/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Notion (https://www.notion.so/my-integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ── HubSpot (https://developers.hubspot.com/)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Airtable (https://airtable.com/create/oauth)
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# ── WhatsApp Meta Cloud API (https://developers.facebook.com/apps/)
# Webhook URL: https://your-domain.com/webhooks/whatsapp/inbound
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=autoflow_whatsapp_verify

# ── Telegram (create bot via @BotFather)
# Webhook URL: https://your-domain.com/webhooks/telegram/inbound
TELEGRAM_BOT_TOKEN=

# ── SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI / LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=               # Google Gemini
OLLAMA_BASE_URL=http://localhost:11434
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
REPLICATE_API_KEY=

# ── Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=        # https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Tool Nodes
BRAVE_SEARCH_API_KEY=         # https://api.search.brave.com/
SERPAPI_API_KEY=              # https://serpapi.com/
OPENWEATHERMAP_API_KEY=       # https://openweathermap.org/api
TAVILY_API_KEY=               # https://tavily.com/
EXA_API_KEY=                  # https://exa.ai/
E2B_API_KEY=                  # https://e2b.dev/ (code interpreter sandbox)

# ── AWS (for S3, SNS, DynamoDB, SES nodes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Zendesk
ZENDESK_SUBDOMAIN=            # your-company (from https://your-company.zendesk.com)
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# ── Linear
LINEAR_API_KEY=               # https://linear.app/settings/api

# ── Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# ── Confluence (Atlassian)
CONFLUENCE_BASE_URL=          # https://your-org.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# ── Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Monday.com
MONDAY_API_KEY=               # https://monday.com/settings/api

# ── Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=us1

# ── Freshdesk
FRESHDESK_DOMAIN=             # your-company (from https://your-company.freshdesk.com)
FRESHDESK_API_KEY=

# ── Intercom
INTERCOM_ACCESS_TOKEN=        # https://app.intercom.com/a/apps/_/developer-hub

# ── Typeform
TYPEFORM_ACCESS_TOKEN=        # https://admin.typeform.com/account#/section/tokens

# ── Box
BOX_ACCESS_TOKEN=             # Developer token (or use client credentials below)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# ── Dropbox
DROPBOX_ACCESS_TOKEN=         # https://www.dropbox.com/developers/apps
